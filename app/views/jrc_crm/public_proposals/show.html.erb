<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= @proposal.proposal_number %> — <%= @proposal.title %> | JRC</title>
  <style>
    :root{--jrc:#073d68;--blue:#0c73d6;--iris:#7758e8;--ink:#152536;--muted:#667789;--line:#dce4ec;--soft:#f4f8fb;--ok:#0c8b68;--warn:#e08a00;--danger:#c43d56}
    *{box-sizing:border-box}body{margin:0;background:#eef3f7;color:var(--ink);font-family:Inter,Segoe UI,Arial,sans-serif}.shell{max-width:1120px;margin:30px auto;padding:0 18px}.proposal{overflow:hidden;border-radius:20px;background:#fff;box-shadow:0 18px 60px rgba(10,47,81,.12)}
    .hero{position:relative;min-height:320px;padding:44px 54px;border-left:8px solid var(--blue);background:radial-gradient(circle at 88% 12%,rgba(119,88,232,.13),transparent 30%),linear-gradient(135deg,#fff,#f7fbff)}.brand{display:flex;align-items:center;justify-content:space-between;gap:24px}.brand img{width:112px;max-height:76px;object-fit:contain}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--blue)}.proposal-id{margin-top:7px;color:var(--muted);font-size:13px}.hero h1{margin:40px 0 12px;color:var(--jrc);font-size:38px;line-height:1.08}.hero .desc{max-width:780px;color:var(--muted);font-size:17px;line-height:1.55}.meta{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:18px;margin-top:30px;padding-top:24px;border-top:2px solid var(--blue)}
    .label{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}.value{margin-top:6px;font-weight:750}.body{padding:40px 54px}.section{margin-bottom:36px}.section h2{margin:0 0 16px;color:var(--jrc);font-size:21px}.section p{color:#33485b;line-height:1.65}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:14px}table{width:100%;min-width:900px;border-collapse:collapse}th{padding:13px 14px;background:var(--blue);color:#fff;text-align:left;font-size:12px}td{padding:14px;border-top:1px solid var(--line);vertical-align:top}.num{text-align:right;white-space:nowrap}.product-name{font-weight:750}.product-desc,.product-meta{margin-top:4px;color:var(--muted);font-size:12px}.summary{width:min(480px,100%);margin:24px 0 0 auto;padding:18px;border-radius:14px;background:var(--soft)}.row{display:flex;justify-content:space-between;gap:24px;padding:6px 0}.row.total{margin-top:8px;padding-top:13px;border-top:1px solid var(--line);color:var(--jrc);font-size:19px;font-weight:800}.discount{color:var(--danger)}
    .cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.card{padding:20px;border:1px solid #e5edf4;border-radius:14px;background:var(--soft)}.card .money{margin-top:7px;color:var(--jrc);font-size:25px;font-weight:850}.text-card{padding:20px;border:1px solid var(--line);border-radius:14px;background:#fbfcfe;line-height:1.65;white-space:pre-line}.status{display:inline-block;padding:6px 11px;border-radius:99px;background:#edf5ff;color:#075fb0;font-size:12px;font-weight:800}.conditions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.condition{display:flex;justify-content:space-between;gap:18px;padding:13px 14px;border:1px solid var(--line);border-radius:12px;background:#fff}.notice{margin:0 54px 20px;padding:14px 18px;border-radius:12px;background:#e8f7f1;color:#096f55;font-weight:700}.notice.error{background:#fff1f3;color:#a72a42}.notice.warn{background:#fff7df;color:#8a5a00}.actions{display:grid;grid-template-columns:1fr;gap:18px;padding:26px 54px 40px;border-top:1px solid var(--line)}.accept-box{padding:20px;border:1px solid #b8e4d6;border-radius:14px;background:#f0fbf7}.accept-box h3{margin:0 0 7px;color:#096f55}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:14px}.fields input[type=text]{min-width:0;width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:10px;font:inherit}.consent{grid-column:1/-1;display:flex;align-items:flex-start;gap:9px;padding:10px 0;color:#33485b;font-size:14px}.consent input{width:18px;height:18px;margin-top:1px;flex:0 0 auto}.accept-submit{grid-column:1/-1;width:100%;min-width:190px;white-space:nowrap}.btns{display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:flex-start;gap:10px}.btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 18px;border:0;border-radius:10px;font-weight:750;text-decoration:none;cursor:pointer}.primary{background:var(--blue);color:#fff}.secondary{border:1px solid var(--line);background:#fff;color:var(--jrc)}.accept{background:var(--ok);color:#fff}.reject{border:1px solid #f0c9d1;background:#fff;color:var(--danger)}.reject-form{width:min(430px,100%);padding:14px;border:1px solid #f0c9d1;border-radius:12px;background:#fff8f9}.reject-form textarea{width:100%;min-height:72px;margin-bottom:9px;padding:10px 11px;border:1px solid var(--line);border-radius:9px;resize:vertical;font:inherit}.accepted{padding:18px;border:1px solid #b8e4d6;border-radius:14px;background:#f0fbf7;color:#096f55}.footer{padding:20px 54px;background:var(--jrc);color:#fff;font-size:12px}
    @media(max-width:820px){.hero,.body,.actions{padding-left:24px;padding-right:24px}.hero h1{font-size:30px}.meta,.cards,.conditions,.actions{grid-template-columns:1fr}.fields{grid-template-columns:1fr}.consent,.accept-submit{grid-column:1}.btns{justify-content:flex-start}.notice{margin-left:24px;margin-right:24px}}
    @media print{body{background:#fff}.shell{max-width:none;margin:0;padding:0}.proposal{border-radius:0;box-shadow:none}.actions{display:none}.hero{break-after:page}.section{break-inside:avoid}.footer{border-top:1px solid #ddd;background:#fff;color:#667789}}
  </style>
</head>
<body>
<%
  contact = @proposal.customer_contact
  status_labels = {
    'draft' => 'Rascunho',
    'pending_approval' => 'Aprovação interna',
    'sent' => 'Enviada',
    'viewed' => 'Visualizada',
    'accepted' => 'Aceita',
    'rejected' => 'Recusada',
    'canceled' => 'Cancelada'
  }
  billing_labels = {
    'one_time' => 'Cobrança única',
    'monthly' => 'Mensal',
    'annual' => 'Anual',
    'usage' => 'Por uso'
  }
  renewal_labels = { 'automatic' => 'Automática', 'manual' => 'Manual', 'none' => 'Sem renovação' }
%>
<div class="shell">
  <article class="proposal">
    <section class="hero">
      <div class="brand">
        <div>
          <div class="eyebrow">Proposta Comercial JRC</div>
          <div class="proposal-id"><%= @proposal.proposal_number %> · versão <%= @proposal.version_number %></div>
        </div>
        <%= image_tag('/brand-assets/logo-jrc.png', alt: 'JRC') %>
      </div>
      <h1><%= @proposal.title %></h1>
      <div class="desc"><%= @proposal.solution_description.presence || 'Solução comercial integrada JRC.' %></div>
      <div class="meta">
        <div>
          <div class="label">Cliente</div>
          <div class="value"><%= contact&.name.presence || @proposal.deal.title %></div>
          <% if contact&.email.present? %><div class="product-meta"><%= contact.email %></div><% end %>
        </div>
        <div><div class="label">Responsável</div><div class="value"><%= @proposal.owner&.name.presence || 'Equipe JRC' %></div></div>
        <div><div class="label">Validade</div><div class="value"><%= (@proposal.valid_until || 15.days.from_now.to_date).strftime('%d/%m/%Y') %></div></div>
        <div><div class="label">Vigência</div><div class="value"><%= @proposal.term_months %> meses</div></div>
      </div>
    </section>

    <div class="body">
      <section class="section">
        <h2>Descrição da solução</h2>
        <%= simple_format(@proposal.solution_description.presence || 'Solução comercial JRC conforme escopo do negócio.') %>
      </section>

      <section class="section">
        <h2>Produtos e serviços</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Produto / Serviço</th><th>Cobrança</th><th class="num">Qtd.</th><th class="num">Preço</th><th class="num">Implantação</th><th class="num">Desconto</th><th class="num">Total inicial</th></tr></thead>
            <tbody>
              <% @proposal.proposal_items.each do |item| %>
                <tr>
                  <td>
                    <div class="product-name"><%= item.name_snapshot %></div>
                    <% if item.description_snapshot.present? %><div class="product-desc"><%= item.description_snapshot %></div><% end %>
                    <div class="product-meta">
                      <%= item.unit_name %>
                      <% if item.included_quantity.to_f.positive? %> · franquia <%= number_with_delimiter(item.included_quantity, delimiter: '.', separator: ',') %> <%= item.included_unit %><% end %>
                      <% if item.activation_days.to_i.positive? %> · ativação em <%= item.activation_days %> dias<% end %>
                    </div>
                  </td>
                  <td><%= billing_labels.fetch(item.billing_model, item.billing_model) %></td>
                  <td class="num"><%= item.quantity %></td>
                  <td class="num"><%= number_to_currency(item.unit_price_cents.to_i / 100.0, unit: 'R$ ', separator: ',', delimiter: '.') %></td>
                  <td class="num"><%= number_to_currency(item.setup_fee_cents.to_i / 100.0, unit: 'R$ ', separator: ',', delimiter: '.') %></td>
                  <td class="num"><%= number_to_currency(item.applied_discount_cents.to_i / 100.0, unit: 'R$ ', separator: ',', delimiter: '.') %></td>
                  <td class="num"><strong><%= number_to_currency(item.initial_total_cents.to_i / 100.0, unit: 'R$ ', separator: ',', delimiter: '.') %></strong></td>
                </tr>
              <% end %>
              <% if @proposal.proposal_items.empty? %><tr><td colspan="7" style="text-align:center;color:#667789">Nenhum item adicionado.</td></tr><% end %>
            </tbody>
          </table>
        </div>
        <div class="summary">
          <div class="row"><span>Implantação</span><strong><%= number_to_currency(@proposal.implementation_cents.to_i / 100.0, unit: 'R$ ', separator: ',', delimiter: '.') %></strong></div>
          <div class="row"><span>Recorrência mensal</span><strong><%= number_to_currency(@proposal.monthly_cents.to_i / 100.0, unit: 'R$ ', separator: ',', delimiter: '.') %></strong></div>
          <% if @proposal.item_discount_cents.positive? %><div class="row discount"><span>Descontos nos itens</span><strong>- <%= number_to_currency(@proposal.item_discount_cents / 100.0, unit: 'R$ ', separator: ',', delimiter: '.') %></strong></div><% end %>
          <% if @proposal.discount_cents.to_i.positive? %><div class="row discount"><span>Desconto comercial</span><strong>- <%= number_to_currency(@proposal.discount_cents.to_i / 100.0, unit: 'R$ ', separator: ',', delimiter: '.') %></strong></div><% end %>
          <div class="row total"><span>Total no primeiro mês</span><span><%= number_to_currency(@proposal.total_cents.to_i / 100.0, unit: 'R$ ', separator: ',', delimiter: '.') %></span></div>
        </div>
      </section>

      <section class="section">
        <h2>Composição financeira</h2>
        <div class="cards">
          <div class="card"><div class="label">Implantação</div><div class="money"><%= number_to_currency(@proposal.implementation_cents.to_i / 100.0, unit: 'R$ ', separator: ',', delimiter: '.') %></div></div>
          <div class="card"><div class="label">Mensalidade</div><div class="money"><%= number_to_currency(@proposal.monthly_cents.to_i / 100.0, unit: 'R$ ', separator: ',', delimiter: '.') %></div></div>
          <div class="card"><div class="label">Primeiro mês</div><div class="money"><%= number_to_currency(@proposal.total_cents.to_i / 100.0, unit: 'R$ ', separator: ',', delimiter: '.') %></div></div>
        </div>
      </section>

      <section class="section">
        <h2>Condições comerciais</h2>
        <div class="conditions">
          <div class="condition"><span>Empresa emissora</span><strong><%= @proposal.issuer_company_name %></strong></div>
          <div class="condition"><span>Forma de pagamento</span><strong><%= @proposal.payment_method.presence || 'A definir' %></strong></div>
          <div class="condition"><span>Dia do vencimento</span><strong><%= @proposal.billing_day.presence || 'A definir' %></strong></div>
          <div class="condition"><span>Primeiro faturamento</span><strong><%= @proposal.first_billing_days.to_i.zero? ? 'Conforme contratação' : "em #{@proposal.first_billing_days} dias" %></strong></div>
          <div class="condition"><span>Impostos</span><strong><%= @proposal.taxes_included? ? 'Inclusos' : 'Não inclusos' %></strong></div>
          <div class="condition"><span>Reajuste anual</span><strong><%= @proposal.annual_adjustment_index.presence || 'A definir' %></strong></div>
          <div class="condition"><span>Renovação</span><strong><%= renewal_labels.fetch(@proposal.renewal_type, @proposal.renewal_type) %></strong></div>
          <div class="condition"><span>Multa de cancelamento</span><strong><%= number_to_percentage(@proposal.cancellation_penalty_percent, precision: 2, strip_insignificant_zeros: true) %></strong></div>
        </div>
      </section>

      <section class="section"><h2>Observações comerciais</h2><div class="text-card"><%= @proposal.commercial_notes.presence || 'Condições sujeitas à validação comercial e técnica. Consumos variáveis e excedentes são faturados conforme utilização.' %></div></section>
      <section class="section"><h2>Próximos passos</h2><div class="text-card"><%= @proposal.next_steps.presence || "1. Aprovação comercial\n2. Alinhamento técnico\n3. Implantação e homologação\n4. Início da operação" %></div></section>
      <section class="section">
        <div class="label">Status</div>
        <div style="margin-top:8px"><span class="status"><%= status_labels.fetch(@proposal.status, @proposal.status) %></span></div>
        <% if @proposal.viewed_count.to_i.positive? %><div class="product-meta">Visualizada <%= @proposal.viewed_count %> vez(es). Última visualização: <%= I18n.l((@proposal.last_viewed_at || @proposal.viewed_at).in_time_zone, format: '%d/%m/%Y %H:%M') %></div><% end %>
      </section>
    </div>

    <% if params[:accepted] %><div class="notice">Proposta aceita com sucesso. Nome, documento, data/hora e IP foram registrados.</div><% end %>
    <% if params[:lifecycle_error] %><div class="notice warn">O aceite foi registrado, mas o Pedido não foi gerado automaticamente. A proposta permanece aceita e o time comercial deve revisar o fluxo no CRM.</div><% end %>
    <% if params[:rejected] %><div class="notice error">Sua resposta foi registrada.</div><% end %>
    <% if params[:response_error] %><div class="notice error">Esta proposta não está disponível para resposta.</div><% end %>
    <% if @acceptance_error.present? %><div class="notice error"><%= @acceptance_error %></div><% end %>

    <div class="actions">
      <div>
        <% if @proposal.accepted? %>
          <div class="accepted"><strong>Proposta aceita</strong><br>Signatário: <%= @proposal.accepted_by_name %><% if @proposal.accepted_at %> · <%= I18n.l(@proposal.accepted_at.in_time_zone, format: '%d/%m/%Y %H:%M') %><% end %></div>
        <% elsif @proposal.customer_response_allowed? %>
          <div class="accept-box">
            <h3>Aceite digital</h3>
            <div style="color:#667789;font-size:13px">Informe os dados do signatário. Data, hora e endereço IP serão registrados.</div>
            <%= form_with url: jrc_crm_public_proposal_accept_path(account_id: @proposal.account_id, token: params[:token]), method: :post, local: true, class: 'fields' do |form| %>
              <%= form.text_field :accepted_by_name, required: true, value: params[:accepted_by_name], placeholder: 'Nome completo do signatário', autocomplete: 'name', aria: { label: 'Nome completo do signatário' } %>
              <%= form.text_field :accepted_by_document, required: true, value: params[:accepted_by_document], placeholder: 'CPF ou CNPJ', autocomplete: 'off', inputmode: 'text', aria: { label: 'CPF ou CNPJ do signatário' } %>
              <label class="consent">
                <%= form.check_box :accepted_terms, { required: true }, '1', '0' %>
                <span>Li e aceito os termos desta proposta.</span>
              </label>
              <%= form.submit 'Aceitar proposta', class: 'btn accept accept-submit', data: { disable_with: 'Registrando aceite…' } %>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="btns">
        <a class="btn primary" target="_blank" rel="noopener" href="<%= jrc_crm_public_proposal_pdf_path(account_id: @proposal.account_id, token: params[:token]) %>">Visualizar PDF</a>
        <a class="btn secondary" href="<%= jrc_crm_public_proposal_pdf_path(account_id: @proposal.account_id, token: params[:token], download: 1) %>">Baixar PDF</a>
        <% if @proposal.customer_response_allowed? %>
          <%= form_with url: jrc_crm_public_proposal_reject_path(account_id: @proposal.account_id, token: params[:token]), method: :post, local: true, class: 'reject-form' do |form| %>
            <%= form.text_area :reason, placeholder: 'Descreva a alteração solicitada ou o motivo da recusa' %>
            <%= form.submit 'Solicitar alteração / recusar', class: 'btn reject' %>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="footer">JRC Conversas • <%= @proposal.proposal_number %> • versão <%= @proposal.version_number %> • <%= @proposal.account.name %></div>
  </article>
</div>
</body>
</html>
