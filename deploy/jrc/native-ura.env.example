# Deployment profile for the Grupo JRC standard image.
# Copy the values into the installation's secret manager, not into an image.
# Replace both origins with the actual installation and approved Broker origins.
FRONTEND_URL=https://conversas.example.invalid
JRC_BROKER_ENABLED=true
JRC_BROKER_ALLOWED_ORIGINS=https://broker.example.invalid
# Generate once per installation: openssl rand -base64 32
# Preserve this value on subsequent releases or existing encrypted tokens cannot be read.
JRC_BROKER_CREDENTIAL_KEY=
JRC_FLOWS_ENABLED=true
# The native Broker executor does not require the legacy external sandbox.
JRC_FLOWS_EXTERNAL_BETA=false
APP_TIME_ZONE=America/Sao_Paulo
TZ=UTC
# Keep the existing SECRET_KEY_BASE and the installation's DB/Redis/storage settings.
# Native Flow credentials are encrypted with a key derived from SECRET_KEY_BASE.
# Do not put company tokens, WhatsApp sessions, flow definitions or account IDs here.
